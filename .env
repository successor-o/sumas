APP_NAME="SUMAS SmartAttend"
APP_ENV=local
APP_KEY=base64:2+zNYEYP9mgJPEh3c8Ql09vVeVWb0pbELNP+3W9V66U=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8004

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database (MySQL recommended; SQLite for dev) ──
#DB_CONNECTION=mysql
#DB_HOST=127.0.0.1
#DB_PORT=3306
#DB_DATABASE=sumas_smartattend
#DB_USERNAME=root
#DB_PASSWORD=

# For local SQLite development, switch to:
DB_CONNECTION=sqlite
DB_DATABASE="database/database.sqlite"

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

# ── Mail ──
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="smartattend@sumas.edu.ng"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ── SUMAS Admin (used by AdminSeeder) ──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=sumas@admin2025

# Sanctum stateful domains - include all local ports so API login persists the session cookie
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:8000,localhost:8004,127.0.0.1,127.0.0.1:8000,127.0.0.1:8004,::1
